{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/manzo-ai/acr/memory-v0.4.schema.json",
  "title": "MANZO AI ACR memory v0.4",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "claim", "scope", "source", "status", "evidence", "created_at", "expires_at", "review_after", "supersedes", "superseded_by", "conflict_key", "history"],
  "properties": {
    "id": {"type": "string", "pattern": "^mem_[0-9]{4,}$"},
    "type": {"enum": ["M0_normative", "M1_operational", "M2_episodic", "M3_procedural"]},
    "claim": {"type": "string", "minLength": 10, "maxLength": 400},
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["project", "applies_when", "excludes"],
      "properties": {
        "project": {"type": "string", "minLength": 1},
        "applies_when": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "excludes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "ref", "proposed_by", "revision"],
      "properties": {
        "kind": {"enum": ["trace", "human", "test"]},
        "ref": {"type": "string", "minLength": 1},
        "proposed_by": {"enum": ["memory_curator", "human", "controller"]},
        "revision": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "status": {"enum": ["candidate", "verified", "approved", "rejected", "superseded", "under_review"]},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["test_id", "result", "run", "context_id", "date"],
        "properties": {
          "test_id": {"type": "string", "minLength": 1},
          "result": {"enum": ["pass", "fail", "fail_then_fixed"]},
          "run": {"type": "string", "minLength": 1},
          "context_id": {"type": "string", "minLength": 1},
          "date": {"type": "string", "format": "date"}
        }
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "review_after": {"type": ["string", "null"], "format": "date-time"},
    "supersedes": {"type": ["string", "null"], "pattern": "^mem_[0-9]{4,}$"},
    "superseded_by": {"type": ["string", "null"], "pattern": "^mem_[0-9]{4,}$"},
    "conflict_key": {"type": ["string", "null"], "maxLength": 100},
    "history": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["from", "to", "by", "at", "reason"],
        "properties": {
          "from": {"type": ["string", "null"]},
          "to": {"enum": ["candidate", "verified", "approved", "rejected", "superseded", "under_review"]},
          "by": {"enum": ["controller", "human", "scheduler"]},
          "at": {"type": "string", "format": "date-time"},
          "reason": {"type": "string", "minLength": 3}
        }
      }
    }
  }
}
