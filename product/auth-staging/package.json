{
  "name": "@manzo-ai/learning-auth-staging",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MANZO AI Learning B2B · invite-only verified email auth prototype, not yet deployed",
  "scripts": {
    "build": "esbuild src/app.js --bundle --format=iife --platform=browser --target=es2022 --minify --outfile=dist/auth-app.js && esbuild src/workspace.js --bundle --format=iife --platform=browser --target=es2022 --minify --outfile=dist/workspace.js",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run test && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.86.0"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}
