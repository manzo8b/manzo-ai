{
  "openapi": "3.1.0",
  "info": {
    "title": "MANZO AI · SaaS API design contract",
    "version": "0.2.0-design",
    "description": "DESIGN ONLY — NO ENDPOINTS DEPLOYED. Portable B2B Learning, Verify and Studio API contract. Authentication, tenant authorization, billing, quotas and model integrations must be implemented server-side; do not treat this document as a running service.",
    "x-manzo-implementation-status": "unimplemented-design-contract"
  },
  "tags": [
    {
      "name": "learning",
      "description": "Student access and server-assessed progress"
    },
    {
      "name": "licensing",
      "description": "Server-owned entitlements, not client-side purchases"
    },
    {
      "name": "agents",
      "description": "Budgeted, human-supervised AI tasks"
    },
    {
      "name": "billing",
      "description": "Provider-verified checkout and webhook events"
    },
    {
      "name": "system",
      "description": "Deployment health probes"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/v1/health": {
      "get": {
        "tags": [
          "system"
        ],
        "operationId": "healthProbe",
        "security": [],
        "summary": "Unprivileged health probe",
        "responses": {
          "200": {
            "description": "Application responding",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "ok"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/organizations/{organizationId}/learning/courses": {
      "get": {
        "tags": [
          "learning"
        ],
        "operationId": "listLearningCourses",
        "summary": "List courses authorized for the active organization",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrganizationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Tenant-scoped courses",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Course"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Membership missing",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Organization not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/organizations/{organizationId}/learning/enrollments": {
      "get": {
        "tags": [
          "learning"
        ],
        "operationId": "listMyEnrollments",
        "summary": "List enrollments for authenticated member; administrators may receive tenant-scoped team records",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrganizationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Membership-scoped enrollments",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Enrollment"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Membership missing",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/organizations/{organizationId}/learning/attempts": {
      "post": {
        "tags": [
          "learning"
        ],
        "operationId": "submitLearningAttempt",
        "summary": "Submit selections for server-side evaluation",
        "description": "The client NEVER supplies score, reviewer, completion status or course entitlement. The backend checks course version, enrollment and question-answer keys before recording the result.",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrganizationId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AttemptSubmission"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Attempt received for assessment",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AttemptReceipt"
                }
              }
            }
          },
          "400": {
            "description": "Invalid question selections",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "No enrollment",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Assessment version not accepted",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/organizations/{organizationId}/licensing/entitlements": {
      "get": {
        "tags": [
          "licensing"
        ],
        "operationId": "listMyEntitlements",
        "summary": "Read server-derived active feature grants (no prices or provider secrets)",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrganizationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Entitlements available to authorized organization member",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EntitlementView"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Membership missing",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/organizations/{organizationId}/agent-runs": {
      "post": {
        "tags": [
          "agents"
        ],
        "operationId": "startControlledAgentRun",
        "summary": "Request budgeted agent execution",
        "description": "Server verifies org membership, feature grant, input visibility, allowed tools, per-user rate limits and an ATOMIC budget reservation before creating a task. This contract is NOT yet implemented.",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrganizationId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Queued with server authorization",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentRunReceipt"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Grant missing",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate/usage/budget limit reached",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/organizations/{organizationId}/agent-runs/{runId}": {
      "get": {
        "tags": [
          "agents"
        ],
        "operationId": "getControlledAgentRun",
        "summary": "Read run state for the correct organization and principal",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrganizationId"
          },
          {
            "$ref": "#/components/parameters/RunId"
          }
        ],
        "responses": {
          "200": {
            "description": "Run visible to authorized principal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentRunReceipt"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Not found or not authorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/billing/checkout-sessions": {
      "post": {
        "tags": [
          "billing"
        ],
        "operationId": "createCheckoutSession",
        "summary": "Request server-priced checkout session",
        "description": "Authenticated caller requests a catalog plan code. Server validates authorized buyer, maps plan to trusted provider price IDs and returns a hosted checkout URL. No client-supplied price, currency, entitlement, trial length or payment success flag is accepted. A redirect never grants service.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckoutRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Hosted checkout session created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckoutReceipt"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Buyer cannot manage organization",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Conflicting session",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/billing/stripe-webhook": {
      "post": {
        "tags": [
          "billing"
        ],
        "operationId": "ingestSignedStripeEvent",
        "summary": "Raw-body signature-checked provider event",
        "security": [],
        "description": "NO JWT is expected. Endpoint must verify the exact raw payload with Stripe-Signature and configured secret before JSON parsing, reject replayed/malformed signatures, persist (provider,event_id) once and update entitlements through trusted transactional logic. NO endpoint is currently deployed.",
        "parameters": [
          {
            "name": "Stripe-Signature",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 10
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true
              },
              "description": "Unmodified raw request body must be used for HMAC verification before parsing."
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authentic event accepted or already processed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "received"
                  ],
                  "properties": {
                    "received": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid signature, timestamp, or payload",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Must be verified server-side; client fields are never sufficient to authorize."
      }
    },
    "parameters": {
      "OrganizationId": {
        "name": "organizationId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "description": "Tenant scope is checked against verified identity, not trusted on its own."
      },
      "RunId": {
        "name": "runId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "Course": {
        "type": "object",
        "required": [
          "id",
          "organizationId",
          "slug",
          "title",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "organizationId": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "published",
              "draft"
            ]
          }
        }
      },
      "Enrollment": {
        "type": "object",
        "required": [
          "courseId",
          "userId",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "courseId": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "completed",
              "revoked"
            ]
          }
        }
      },
      "AttemptSubmission": {
        "type": "object",
        "required": [
          "courseId",
          "versionId",
          "assessmentId",
          "selections"
        ],
        "additionalProperties": false,
        "properties": {
          "courseId": {
            "type": "string",
            "format": "uuid"
          },
          "versionId": {
            "type": "string",
            "format": "uuid"
          },
          "assessmentId": {
            "type": "string",
            "maxLength": 160
          },
          "selections": {
            "type": "array",
            "minItems": 1,
            "maxItems": 300,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "questionId",
                "optionIds"
              ],
              "properties": {
                "questionId": {
                  "type": "string",
                  "maxLength": 160
                },
                "optionIds": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 20,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "maxLength": 160
                  }
                }
              }
            }
          }
        }
      },
      "AttemptReceipt": {
        "type": "object",
        "required": [
          "attemptId",
          "state"
        ],
        "additionalProperties": false,
        "properties": {
          "attemptId": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "enum": [
              "accepted",
              "needs_review",
              "rejected"
            ]
          }
        }
      },
      "EntitlementView": {
        "type": "object",
        "required": [
          "feature",
          "status",
          "validUntil"
        ],
        "additionalProperties": false,
        "properties": {
          "feature": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive",
              "suspended",
              "revoked"
            ]
          },
          "validUntil": {
            "type": "string",
            "format": "date-time"
          },
          "remainingUnits": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "AgentRequest": {
        "type": "object",
        "required": [
          "feature",
          "inputReference"
        ],
        "additionalProperties": false,
        "properties": {
          "feature": {
            "type": "string",
            "enum": [
              "verify.process",
              "studio.generate"
            ]
          },
          "inputReference": {
            "type": "string",
            "format": "uuid"
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 12,
            "maxLength": 120
          },
          "humanReviewRequired": {
            "type": "boolean",
            "const": true,
            "description": "Client cannot override server-required human approvals."
          }
        }
      },
      "AgentRunReceipt": {
        "type": "object",
        "required": [
          "runId",
          "state"
        ],
        "additionalProperties": false,
        "properties": {
          "runId": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "needs_review",
              "completed",
              "failed",
              "cancelled"
            ]
          },
          "estimatedCostMinorUnits": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "CheckoutRequest": {
        "type": "object",
        "required": [
          "organizationId",
          "planCode"
        ],
        "additionalProperties": false,
        "properties": {
          "organizationId": {
            "type": "string",
            "format": "uuid"
          },
          "planCode": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{2,100}$"
          }
        }
      },
      "CheckoutReceipt": {
        "type": "object",
        "required": [
          "checkoutSessionId",
          "checkoutUrl"
        ],
        "additionalProperties": false,
        "properties": {
          "checkoutSessionId": {
            "type": "string"
          },
          "checkoutUrl": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    }
  }
}
