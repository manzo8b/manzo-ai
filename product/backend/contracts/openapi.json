{
  "openapi": "3.1.0",
  "info": {
    "title": "MANZO AI · SaaS API design contract",
    "version": "0.5.0-my-learning-source-only",
    "description": "Learning B2B Edge Functions adapter and verified My Learning read-only client implemented and QA-tested in source. NOT DEPLOYED: tenant integration, recovery and rate limits are go-live gates. Studio and billing remain design-only.",
    "x-manzo-implementation-status": "staging-source-only",
    "x-manzo-implemented-endpoints": [
      "GET /v1/learning/organizations",
      "GET /v1/organizations/{organizationId}/learning/courses",
      "GET /v1/organizations/{organizationId}/learning/progress",
      "GET /v1/organizations/{organizationId}/learning/enrollments",
      "POST /v1/organizations/{organizationId}/learning/seats",
      "DELETE /v1/organizations/{organizationId}/learning/seats/{memberId}",
      "POST /v1/organizations/{organizationId}/learning/enrollments",
      "POST /v1/organizations/{organizationId}/learning/progress",
      "POST /v1/organizations/{organizationId}/learning/attempts"
    ]
  },
  "tags": [
    {
      "name": "learning",
      "description": "Student access and server-assessed progress"
    },
    {
      "name": "licensing",
      "description": "Server-owned entitlements, not client-side purchases"
    },
    {
      "name": "agents",
      "description": "Budgeted, human-supervised AI tasks"
    },
    {
      "name": "billing",
      "description": "Provider-verified checkout and webhook events"
    },
    {
      "name": "system",
      "description": "Deployment health probes"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/v1/health": {
      "get": {
        "tags": [
          "system"
        ],
        "operationId": "healthProbe",
        "security": [],
        "summary": "Unprivileged health probe",
        "responses": {
          "200": {
            "description": "Application responding",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "ok"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/organizations/{organizationId}/learning/courses": {
      "get": {
        "tags": [
          "learning"
        ],
        "operationId": "listLearningCourses",
        "summary": "List courses authorized for the active organization",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrganizationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Tenant-scoped courses",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "courses"
                  ],
                  "properties": {
                    "courses": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Course"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Membership missing",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Organization not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/organizations/{organizationId}/learning/enrollments": {
      "get": {
        "tags": [
          "learning"
        ],
        "operationId": "listMyEnrollments",
        "summary": "List only the verified user's own enrollments in the requested organization",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrganizationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Membership-scoped enrollments",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "enrollments"
                  ],
                  "properties": {
                    "enrollments": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/MyEnrollment"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Membership missing",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "description": "The backend filters by the verified actor AND organization ID; even tenant administrators get only their own enrollments in My Learning."
      },
      "post": {
        "tags": [
          "learning"
        ],
        "operationId": "enrollLearningStudent",
        "summary": "Enroll a currently licensed member in a published course",
        "description": "Only a server-authorized owner, admin or instructor may enroll. Learner's identity, seat grant and course status are validated server-side. This API is not deployed.",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrganizationId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnrollmentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Enrollment is active",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnrollmentReceipt"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "No authorization or active seat",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Course unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/organizations/{organizationId}/learning/attempts": {
      "post": {
        "tags": [
          "learning"
        ],
        "operationId": "submitLearningAttempt",
        "summary": "Submit selections for server-side evaluation",
        "description": "Single-choice assessment v0.4: answers object maps question IDs to a single option. Server verifies membership, active license, enrollment and the private answer key. No client-provided scores.",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrganizationId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AttemptSubmission"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Answer selections graded and recorded by trusted backend; numeric score not trusted from client and not included in this receipt.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AttemptReceipt"
                }
              }
            }
          },
          "400": {
            "description": "Invalid question selections",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "No enrollment",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Assessment version not accepted",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Unknown, malformed or missing assessment answers",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/organizations/{organizationId}/licensing/entitlements": {
      "get": {
        "tags": [
          "licensing"
        ],
        "operationId": "listMyEntitlements",
        "summary": "Read server-derived active feature grants (no prices or provider secrets)",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrganizationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Entitlements available to authorized organization member",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EntitlementView"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Membership missing",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/organizations/{organizationId}/agent-runs": {
      "post": {
        "tags": [
          "agents"
        ],
        "operationId": "startControlledAgentRun",
        "summary": "Request budgeted agent execution",
        "description": "Server verifies org membership, feature grant, input visibility, allowed tools, per-user rate limits and an ATOMIC budget reservation before creating a task. This contract is NOT yet implemented.",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrganizationId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Queued with server authorization",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentRunReceipt"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Grant missing",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate/usage/budget limit reached",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/organizations/{organizationId}/agent-runs/{runId}": {
      "get": {
        "tags": [
          "agents"
        ],
        "operationId": "getControlledAgentRun",
        "summary": "Read run state for the correct organization and principal",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrganizationId"
          },
          {
            "$ref": "#/components/parameters/RunId"
          }
        ],
        "responses": {
          "200": {
            "description": "Run visible to authorized principal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentRunReceipt"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Not found or not authorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/billing/checkout-sessions": {
      "post": {
        "tags": [
          "billing"
        ],
        "operationId": "createCheckoutSession",
        "summary": "Request server-priced checkout session",
        "description": "Authenticated caller requests a catalog plan code. Server validates authorized buyer, maps plan to trusted provider price IDs and returns a hosted checkout URL. No client-supplied price, currency, entitlement, trial length or payment success flag is accepted. A redirect never grants service.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckoutRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Hosted checkout session created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckoutReceipt"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Buyer cannot manage organization",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Conflicting session",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/billing/stripe-webhook": {
      "post": {
        "tags": [
          "billing"
        ],
        "operationId": "ingestSignedStripeEvent",
        "summary": "Raw-body signature-checked provider event",
        "security": [],
        "description": "NO JWT is expected. Endpoint must verify the exact raw payload with Stripe-Signature and configured secret before JSON parsing, reject replayed/malformed signatures, persist (provider,event_id) once and update entitlements through trusted transactional logic. NO endpoint is currently deployed.",
        "parameters": [
          {
            "name": "Stripe-Signature",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 10
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true
              },
              "description": "Unmodified raw request body must be used for HMAC verification before parsing."
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authentic event accepted or already processed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "received"
                  ],
                  "properties": {
                    "received": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid signature, timestamp, or payload",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/organizations/{organizationId}/learning/seats": {
      "post": {
        "tags": [
          "learning"
        ],
        "operationId": "assignLearningSeat",
        "summary": "Assign an active organization seat to an existing member",
        "description": "Backend-only mutation. Owner/admin authentication and an active organization grant are required. Seat quota is checked atomically against concurrent requests. THIS API IS NOT DEPLOYED.",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrganizationId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LearningSeatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Seat assigned or previously assigned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LearningSeatReceipt"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Not an organization administrator",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "No free seats or license inactive",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/organizations/{organizationId}/learning/seats/{memberId}": {
      "delete": {
        "tags": [
          "learning"
        ],
        "operationId": "releaseLearningSeat",
        "summary": "Release organization seat, revoking active enrollments",
        "description": "Backend-only mutation. Only verified owner/admin. Billing grant remains server-owned.",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrganizationId"
          },
          {
            "$ref": "#/components/parameters/MemberId"
          }
        ],
        "responses": {
          "200": {
            "description": "Seat released or already absent",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LearningSeatReceipt"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Not authorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/organizations/{organizationId}/learning/progress": {
      "get": {
        "tags": [
          "learning"
        ],
        "operationId": "listLearningProgress",
        "summary": "Read authenticated learner progress (or authorized instructor report)",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrganizationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Tenant-scoped historical progress, including records after license revocation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "progress"
                  ],
                  "properties": {
                    "progress": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/LearningProgressRecord"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Organization membership missing",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "learning"
        ],
        "operationId": "completeLearningModule",
        "summary": "Record a valid published module completion under verified actor identity",
        "description": "Server derives member user ID from verified session, confirms active grant, enrollment and published version, then performs an idempotent upsert. Client cannot provide scores or user ID. API NOT DEPLOYED.",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrganizationId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProgressSubmission"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Module completion recorded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProgressReceipt"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "License or enrollment missing",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Module/version unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/learning/organizations": {
      "get": {
        "tags": [
          "learning"
        ],
        "operationId": "listMyLearningOrganizations",
        "summary": "Discover only active organizations for the verified user",
        "description": "Authenticated student only. No user ID or organization ID is accepted from the browser. Source-only until the Learning API rollout.",
        "responses": {
          "200": {
            "description": "Verified account's active organization memberships",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "organizations"
                  ],
                  "properties": {
                    "organizations": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/MyOrganization"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "No valid session or insufficient membership",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "No valid session or insufficient membership",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Must be verified server-side; client fields are never sufficient to authorize."
      }
    },
    "parameters": {
      "OrganizationId": {
        "name": "organizationId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "description": "Tenant scope is checked against verified identity, not trusted on its own."
      },
      "RunId": {
        "name": "runId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "MemberId": {
        "name": "memberId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "description": "User identity must be checked against verified organization membership."
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "Course": {
        "type": "object",
        "required": [
          "id",
          "organizationId",
          "slug",
          "title",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "organizationId": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "published",
              "draft"
            ]
          }
        }
      },
      "Enrollment": {
        "type": "object",
        "required": [
          "courseId",
          "userId",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "courseId": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "completed",
              "revoked"
            ]
          }
        }
      },
      "AttemptSubmission": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "courseId",
          "versionId",
          "assessmentId",
          "answers"
        ],
        "properties": {
          "courseId": {
            "type": "string",
            "format": "uuid"
          },
          "versionId": {
            "type": "string",
            "format": "uuid"
          },
          "assessmentId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,160}$"
          },
          "answers": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 40,
            "additionalProperties": false,
            "patternProperties": {
              "^[A-Za-z0-9_.:-]{1,160}$": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "description": "Each question ID maps to a single selected option ID. The private answer key stays in the database. No client score or reviewer."
          }
        }
      },
      "AttemptReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attemptId",
          "state"
        ],
        "properties": {
          "attemptId": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "const": "recorded"
          }
        }
      },
      "EntitlementView": {
        "type": "object",
        "required": [
          "feature",
          "status",
          "validUntil"
        ],
        "additionalProperties": false,
        "properties": {
          "feature": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive",
              "suspended",
              "revoked"
            ]
          },
          "validUntil": {
            "type": "string",
            "format": "date-time"
          },
          "remainingUnits": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "AgentRequest": {
        "type": "object",
        "required": [
          "feature",
          "inputReference"
        ],
        "additionalProperties": false,
        "properties": {
          "feature": {
            "type": "string",
            "enum": [
              "verify.process",
              "studio.generate"
            ]
          },
          "inputReference": {
            "type": "string",
            "format": "uuid"
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 12,
            "maxLength": 120
          },
          "humanReviewRequired": {
            "type": "boolean",
            "const": true,
            "description": "Client cannot override server-required human approvals."
          }
        }
      },
      "AgentRunReceipt": {
        "type": "object",
        "required": [
          "runId",
          "state"
        ],
        "additionalProperties": false,
        "properties": {
          "runId": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "needs_review",
              "completed",
              "failed",
              "cancelled"
            ]
          },
          "estimatedCostMinorUnits": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "CheckoutRequest": {
        "type": "object",
        "required": [
          "organizationId",
          "planCode"
        ],
        "additionalProperties": false,
        "properties": {
          "organizationId": {
            "type": "string",
            "format": "uuid"
          },
          "planCode": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{2,100}$"
          }
        }
      },
      "CheckoutReceipt": {
        "type": "object",
        "required": [
          "checkoutSessionId",
          "checkoutUrl"
        ],
        "additionalProperties": false,
        "properties": {
          "checkoutSessionId": {
            "type": "string"
          },
          "checkoutUrl": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "LearningSeatRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "memberUserId"
        ],
        "properties": {
          "memberUserId": {
            "type": "string",
            "format": "uuid",
            "description": "Target must already be verified member of organization; caller must be owner/admin."
          }
        }
      },
      "LearningSeatReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "result",
          "memberUserId"
        ],
        "properties": {
          "result": {
            "type": "string",
            "enum": [
              "assigned",
              "already_assigned",
              "released",
              "not_assigned"
            ]
          },
          "memberUserId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "EnrollmentRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "memberUserId",
          "courseId"
        ],
        "properties": {
          "memberUserId": {
            "type": "string",
            "format": "uuid"
          },
          "courseId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "EnrollmentReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "enrollmentId",
          "state"
        ],
        "properties": {
          "enrollmentId": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "const": "active"
          }
        }
      },
      "ProgressSubmission": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "courseId",
          "versionId",
          "moduleKey"
        ],
        "properties": {
          "courseId": {
            "type": "string",
            "format": "uuid"
          },
          "versionId": {
            "type": "string",
            "format": "uuid"
          },
          "moduleKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9_.-]+$"
          }
        }
      },
      "ProgressReceipt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "progressId",
          "moduleKey",
          "state"
        ],
        "properties": {
          "progressId": {
            "type": "string",
            "format": "uuid"
          },
          "moduleKey": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "const": "completed"
          }
        }
      },
      "LearningProgressRecord": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "courseId",
          "versionId",
          "userId",
          "moduleKey",
          "completedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "courseId": {
            "type": "string",
            "format": "uuid"
          },
          "versionId": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "moduleKey": {
            "type": "string"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "MyOrganization": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "organizationId",
          "name",
          "role"
        ],
        "properties": {
          "organizationId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "admin",
              "instructor",
              "learner"
            ]
          }
        }
      },
      "MyEnrollment": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "courseId",
          "status",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "courseId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "completed",
              "revoked"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
